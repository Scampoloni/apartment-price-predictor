# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Local working copies retained during the audit (not repository artifacts)
/notebook_training(1).ipynb
/conversational_agent/doc/

# Data — never commit raw data to version control
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained price artifacts are intentionally committed through Git LFS.
# Ad-hoc pickle files elsewhere are ignored to prevent stale duplicate models.
*.pkl
!price_estimator/models/.gitkeep

# Results
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep

# Environment variables
.env
*.env

# OS
.DS_Store
Thumbs.db
